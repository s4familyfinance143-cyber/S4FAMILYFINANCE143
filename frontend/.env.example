# Copy to frontend/.env
# Firebase keys are built into src/firebase/config.js (s4-family-finance)

VITE_API_BASE=http://127.0.0.1:8000

# Google Drive backup (OAuth 2.0 Web client ID — see deploy/GOOGLE_DRIVE_SETUP.md)
VITE_GOOGLE_CLIENT_ID=

# Web Push (FCM) — Firebase Console → Project settings → Cloud Messaging → Web Push certificates
# Generate a key pair and paste the public key here. Without it, in-app + browser Notification API still work.
VITE_FIREBASE_VAPID_KEY=

# Optional: instant verification email via your own API (Admin SDK + Resend/Brevo/SMTP).
# POST Bearer <Firebase ID token> → generateEmailVerificationLink + send mail.
# Without this, Firebase Auth’s built-in mailer is used (can be delayed on free tier).
# VITE_CUSTOM_VERIFY_EMAIL_URL=https://your-cloud-function-or-api/verify-email

# Firebase-only mode (no local backend — view/restore from Firestore cache)
# VITE_FIREBASE_FIRST=true
