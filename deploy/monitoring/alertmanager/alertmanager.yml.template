global:
  resolve_timeout: 5m

route:
  receiver: blackhole
  group_by: ["alertname", "severity"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers:
        - channel="pagerduty"
      receiver: pagerduty
    - matchers:
        - channel="slack"
      receiver: slack
    - matchers:
        - channel="email"
      receiver: email

receivers:
  - name: blackhole

  - name: slack
    webhook_configs:
      - url: "${SLACK_WEBHOOK_URL}"
        send_resolved: true

  - name: pagerduty
    webhook_configs:
      - url: "${PAGERDUTY_WEBHOOK_URL}"
        send_resolved: true

  - name: email
    webhook_configs:
      - url: "${EMAIL_WEBHOOK_URL}"
        send_resolved: true

inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal: ["alertname"]
