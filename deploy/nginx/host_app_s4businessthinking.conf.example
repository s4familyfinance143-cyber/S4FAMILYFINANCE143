# Host nginx (marketing VPS already serving s4businessthinking.com).
# Install as e.g. /etc/nginx/sites-available/app.s4businessthinking.com
# then: ln -s ... sites-enabled && nginx -t && systemctl reload nginx
#
# Prerequisites:
#   1) DNS A: app → VPS IP
#   2) Docker stack with host-nginx overlay on 127.0.0.1:8088
#   3) certbot --nginx -d app.s4businessthinking.com

upstream s4_family_finance_app {
    server 127.0.0.1:8088;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name app.s4businessthinking.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.s4businessthinking.com;

    # certbot will fill these (or set manually):
    # ssl_certificate     /etc/letsencrypt/live/app.s4businessthinking.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/app.s4businessthinking.com/privkey.pem;

    client_max_body_size 20m;

    location / {
        proxy_pass http://s4_family_finance_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }
}
