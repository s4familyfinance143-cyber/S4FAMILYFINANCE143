# Copy to deploy/docker/.env.production and fill real secrets before:
#   docker compose --env-file .env.production -f docker-compose.production.yml \
#     -f docker-compose.host-nginx.yml -f docker-compose.vps-shared-slim.yml up -d --build
#
# Never commit the filled .env.production file.
# Full restore steps: deploy/RESTORE_FROM_GITHUB.md

POSTGRES_DB=s4_family_finance_production
POSTGRES_USER=s4_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

DATABASE_URL=postgresql+psycopg://s4_user:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/s4_family_finance_production

JWT_SECRET_KEY=CHANGE_ME_RANDOM_64_PLUS_CHAR_SECRET
JWT_ALGORITHM=HS256

REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0

MINIO_ROOT_USER=s4minio
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=s4-family-finance
S3_ACCESS_KEY=s4minio
S3_SECRET_KEY=CHANGE_ME_STRONG_MINIO_PASSWORD

# Document vault: s3 (MinIO) default. Optional company Drive: see deploy/GOOGLE_DRIVE_VAULT_SETUP.md
DOCUMENT_VAULT_BACKEND=s3
GDRIVE_SERVICE_ACCOUNT_JSON=/secrets/gdrive.json
GDRIVE_ROOT_FOLDER_ID=
GDRIVE_FAMILY_SOFT_CAP_MB=500

CORS_ORIGINS=["https://app.s4businessthinking.com","https://www.s4businessthinking.com","https://localhost","http://localhost","capacitor://localhost","ionic://localhost"]
APP_PUBLIC_URL=https://app.s4businessthinking.com
VITE_API_BASE=/api/v1
VITE_FIREBASE_FIRST=false
# Public OAuth Web client id (safe in frontend build) — deploy/PER_USER_GOOGLE_DRIVE.md
VITE_GOOGLE_CLIENT_ID=337941876187-bolk7n1dbmbiclqf1kqr2g6t2tq92bnc.apps.googleusercontent.com

NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_FCM_ENABLED=false
AUTH_EMAIL_ENABLED=true
AUTO_CREATE_TABLES=false

# --- Brevo / production SMTP (fill real password on VPS only) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_BREVO_SMTP_LOGIN
SMTP_PASSWORD=CHANGE_ME_BREVO_SMTP_KEY
SMTP_FROM_EMAIL=CHANGE_ME_VERIFIED_SENDER@example.com
SMTP_FROM_NAME=S4 Family Finance
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- OTP mobile (console = log only; replace with twilio/http/whatsapp when ready) ---
SMS_PROVIDER=console
OTP_LENGTH=6
OTP_TTL_SECONDS=600
# WHATSAPP_PROVIDER=meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=otp_verify
# SMS_PROVIDER=http
# SMS_API_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=S4FAMILY

CELERY_ENABLED=true
ENABLE_RECURRING_WORKER=true
ENABLE_AUTO_BACKUP_WORKER=true

# Optional monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD
GRAFANA_ROOT_URL=https://grafana.example.com
