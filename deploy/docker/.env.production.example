# Copy to deploy/docker/.env.production and fill real secrets before:
#   docker compose --env-file .env.production -f docker-compose.production.yml up -d --build
#
# Never commit the filled .env.production file.

POSTGRES_DB=s4_family_finance_production
POSTGRES_USER=s4_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

DATABASE_URL=postgresql+psycopg://s4_user:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/s4_family_finance_production

JWT_SECRET_KEY=CHANGE_ME_RANDOM_64_PLUS_CHAR_SECRET
# Prefer HS256 in compose unless you mount persistent RSA PEMs (ephemeral container keys break multi-replica / restarts).
JWT_ALGORITHM=HS256
# For RS256 instead (pick ONE approach):
# JWT_ALGORITHM=RS256
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# OR mount backend/secrets/jwt_rs256_*.pem into the container and set:
# JWT_RSA_KEYS_MOUNTED=true

REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0

MINIO_ROOT_USER=s4minio
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=s4-family-finance
S3_ACCESS_KEY=s4minio
S3_SECRET_KEY=CHANGE_ME_STRONG_MINIO_PASSWORD
# Document vault — Google Drive (company service account)
# See deploy/GOOGLE_DRIVE_VAULT_SETUP.md
# DOCUMENT_VAULT_BACKEND=gdrive
# GDRIVE_SERVICE_ACCOUNT_JSON=/secrets/gdrive.json
# GDRIVE_ROOT_FOLDER_ID=
# GDRIVE_FAMILY_SOFT_CAP_MB=500

DOCUMENT_VAULT_BACKEND=s3

# Sales site stays on https://s4businessthinking.com — app runs on subdomain.
CORS_ORIGINS=["https://app.s4businessthinking.com"]
VITE_API_BASE=/api/v1
VITE_FIREBASE_FIRST=false
# Per-user Google Drive backup (OAuth Web client — see deploy/PER_USER_GOOGLE_DRIVE.md)
# VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
APP_PUBLIC_URL=https://app.s4businessthinking.com

NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_FCM_ENABLED=false
AUTH_EMAIL_ENABLED=true

# --- Sentry (optional — set on VPS + GitHub Actions for deploy markers) ---
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=set-by-ci
# Frontend browser Sentry (baked at image build time):
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# --- Monitoring (Grafana + Prometheus — use monitoring.prod overlay) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD
GRAFANA_ROOT_URL=https://grafana.s4family.app

# Alert webhooks (optional until providers are configured)
# SLACK_WEBHOOK_URL=
# PAGERDUTY_WEBHOOK_URL=
# EMAIL_WEBHOOK_URL=

# Optional dedicated bucket for daily postgres dumps (defaults to S3_BUCKET)
# BACKUP_S3_BUCKET=s4-family-backups

# --- Staging Mailpit (docker compose --profile staging) ---
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_FROM_EMAIL=noreply@s4family.local
# SMTP_USE_TLS=false
# SMTP_USE_SSL=false
# NOTIFICATION_EMAIL_ENABLED=true

# --- Real production SMTP (Resend / Brevo / provider) ---
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@your-domain.example
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# --- OTP mobile (WhatsApp preferred, else SMS) ---
# WHATSAPP_PROVIDER=meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=otp_verify
# SMS_PROVIDER=http
# SMS_API_URL=https://provider.example/send
# SMS_API_KEY=
# SMS_SENDER_ID=S4FAMILY
OTP_LENGTH=6
OTP_TTL_SECONDS=600

# FCM_PROJECT_ID=
# FCM_CREDENTIALS_PATH=/secrets/firebase.json

CELERY_ENABLED=true

ENABLE_RECURRING_WORKER=true
ENABLE_AUTO_BACKUP_WORKER=true
