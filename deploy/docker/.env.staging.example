# Staging / local VM template for docker compose.
# Copy to deploy/docker/.env.production on the VM, then:
#   docker compose --env-file .env.production -f docker-compose.production.yml --profile staging up -d --build
#
# Placeholders (CHANGE_ME_*) are intentional so vps_go_live_deploy.sh refuses this file on a public VPS.
# Replace with strong unique values before any public exposure.
# Never commit a filled .env.production.

POSTGRES_DB=s4_family_finance_production
POSTGRES_USER=s4_user
POSTGRES_PASSWORD=CHANGE_ME_STAGING_ONLY_Postgres_32chars

DATABASE_URL=postgresql+psycopg://s4_user:CHANGE_ME_STAGING_ONLY_Postgres_32chars@postgres:5432/s4_family_finance_production

JWT_SECRET_KEY=CHANGE_ME_STAGING_ONLY_JwtSecret_Key_AtLeast_32_Chars

REDIS_PASSWORD=CHANGE_ME_STAGING_ONLY_Redis_32chars
REDIS_URL=redis://:CHANGE_ME_STAGING_ONLY_Redis_32chars@redis:6379/0

MINIO_ROOT_USER=s4minio
MINIO_ROOT_PASSWORD=CHANGE_ME_STAGING_ONLY_Minio_32chars
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=s4-family-finance
S3_ACCESS_KEY=s4minio
S3_SECRET_KEY=CHANGE_ME_STAGING_ONLY_Minio_32chars
DOCUMENT_VAULT_BACKEND=s3

# Host browser / public staging URL
CORS_ORIGINS=["https://staging.s4family.app","http://127.0.0.1:8088","http://localhost:8088"]
VITE_API_BASE=/api
APP_PUBLIC_URL=https://staging.s4family.app

AUTH_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_FCM_ENABLED=false

# Mailpit (compose profile: staging)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@s4family.local
SMTP_USE_TLS=false
SMTP_USE_SSL=false

# --- Sentry (optional) ---
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=staging
# SENTRY_RELEASE=set-by-ci

ENABLE_RECURRING_WORKER=true
ENABLE_AUTO_BACKUP_WORKER=true
CELERY_ENABLED=true

# Monitoring (optional overlay)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STAGING_GRAFANA
GRAFANA_ROOT_URL=https://grafana.staging.s4family.app
