rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function emailOk() {
      return request.auth.token.email_verified == true;
    }

    function familyMemberLoose(familyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function familyMember(familyId) {
      return familyMemberLoose(familyId);
    }

    function familyOwner(familyId) {
      return familyMember(familyId)
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'OWNER';
    }

    function familyAdminOrOwner(familyId) {
      return familyMember(familyId)
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role in ['OWNER', 'ADMIN'];
    }

    function memberRole(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role;
    }

    function familySettingsKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['currency', 'default_currency', 'timezone', 'updated_at', 'name']);
    }

    function familyHasNoOwner(familyId) {
      return !exists(/databases/$(database)/documents/families/$(familyId))
        || !('owner_uid' in get(/databases/$(database)/documents/families/$(familyId)).data)
        || get(/databases/$(database)/documents/families/$(familyId)).data.owner_uid == null
        || get(/databases/$(database)/documents/families/$(familyId)).data.owner_uid == '';
    }

    function familyOwnerUid(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data.owner_uid;
    }

    // User profile already points at this family (cloud-only single-family accounts).
    function profileLinkedToFamily(familyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.family_id == familyId;
    }

    // Claim / keep OWNER when family has no owner OR meta already points at this uid.
    function selfClaimOwnerRole(familyId) {
      return signedIn()
        && request.auth.uid == memberId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'OWNER'
        && (
          familyHasNoOwner(familyId)
          || (
            exists(/databases/$(database)/documents/families/$(familyId))
            && familyOwnerUid(familyId) == request.auth.uid
          )
        );
    }

    function familyMetaBootstrapOwner(familyId) {
      return familyMemberLoose(familyId)
        && memberRole(familyId) == 'OWNER'
        && (
          !('owner_uid' in resource.data)
          || resource.data.owner_uid == null
          || resource.data.owner_uid == ''
          || resource.data.owner_uid == request.auth.uid
        )
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['owner_uid', 'name', 'id', 'created_at', 'updated_at', 'currency', 'default_currency', 'timezone']);
    }

    // Linked member may refresh meta when they are (or should be) the family owner.
    // Do NOT allow stealing owner_uid just because profile.family_id matches (joiners).
    function familyMetaOwnerHeal(familyId) {
      return familyMemberLoose(familyId)
        && request.resource.data.owner_uid == request.auth.uid
        && (
          familyHasNoOwner(familyId)
          || resource.data.owner_uid == request.auth.uid
        );
    }

    function selfCreateFirstOwner(familyId) {
      return signedIn()
        && request.auth.uid == memberId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'OWNER'
        && (
          familyHasNoOwner(familyId)
          || familyOwnerUid(familyId) == request.auth.uid
          || profileLinkedToFamily(familyId)
        );
    }

    function selfCreateLinkedMember(familyId) {
      return signedIn()
        && request.auth.uid == memberId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['MEMBER', 'OWNER']
        && profileLinkedToFamily(familyId);
    }

    function inviteDoc(code) {
      return get(/databases/$(database)/documents/familyInvites/$(code));
    }

    function inviteValidForJoin(familyId, code) {
      return code is string
        && code.size() >= 4
        && exists(/databases/$(database)/documents/familyInvites/$(code))
        && inviteDoc(code).data.status == 'ACTIVE'
        && inviteDoc(code).data.family_id == familyId
        && (
          !('max_uses' in inviteDoc(code).data)
          || inviteDoc(code).data.max_uses == null
          || (
            // Coerce so int/string max_uses from older clients still work
            (
              inviteDoc(code).data.uses is int
                ? inviteDoc(code).data.uses
                : int(inviteDoc(code).data.uses)
            )
            <
            (
              inviteDoc(code).data.max_uses is int
                ? inviteDoc(code).data.max_uses
                : int(inviteDoc(code).data.max_uses)
            )
          )
        );
    }

    function selfCreateViaInvite(familyId) {
      return signedIn()
        && request.auth.uid == memberId
        && request.resource.data.uid == request.auth.uid
        && 'invite_code' in request.resource.data
        && request.resource.data.invite_code is string
        && inviteValidForJoin(familyId, request.resource.data.invite_code)
        && (
          request.resource.data.role in ['MEMBER', 'VIEWER', 'CHILD']
          || (
            request.resource.data.role == 'OWNER'
            && inviteDoc(request.resource.data.invite_code).data.owner_uid == request.auth.uid
          )
        );
    }

    function memberSelfSafeKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'email',
          'display_name',
          'fcm_token_latest',
          'fcm_updated_at',
          'updated_at',
          'status',
          'photo_url',
          'avatar_url',
          'invite_code',
          'relationship_type',
          'relationship',
          'relationship_display_label',
          'joined_at'
        ]);
    }

    function inviteConsumeKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['uses', 'status', 'updated_at', 'last_joined_uid']);
    }

    function userFamilyIdWriteOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['family_id'])
        || request.resource.data.family_id == null
        || request.resource.data.family_id == ''
        || (
          'family_id' in resource.data
          && request.resource.data.family_id == resource.data.family_id
        )
        || familyMemberLoose(request.resource.data.family_id)
        || familyHasNoOwner(request.resource.data.family_id)
        || (
          // Documented owner may re-link profile before membership doc exists
          exists(/databases/$(database)/documents/families/$(request.resource.data.family_id))
          && familyOwnerUid(request.resource.data.family_id) == request.auth.uid
        )
        || (
          // Joining via invite: allow linking profile after membership create in same flow
          'joined_via_invite' in request.resource.data
          && request.resource.data.joined_via_invite is string
          && request.resource.data.joined_via_invite.size() >= 4
          && exists(/databases/$(database)/documents/familyInvites/$(request.resource.data.joined_via_invite))
          && get(/databases/$(database)/documents/familyInvites/$(request.resource.data.joined_via_invite)).data.family_id
            == request.resource.data.family_id
          && get(/databases/$(database)/documents/familyInvites/$(request.resource.data.joined_via_invite)).data.status == 'ACTIVE'
        );
    }

    function userFamilyIdCreateOk() {
      return !('family_id' in request.resource.data)
        || request.resource.data.family_id == null
        || request.resource.data.family_id == ''
        || familyMemberLoose(request.resource.data.family_id)
        || familyHasNoOwner(request.resource.data.family_id)
        || (
          exists(/databases/$(database)/documents/families/$(request.resource.data.family_id))
          && familyOwnerUid(request.resource.data.family_id) == request.auth.uid
        )
        || (
          'joined_via_invite' in request.resource.data
          && request.resource.data.joined_via_invite is string
          && request.resource.data.joined_via_invite.size() >= 4
          && exists(/databases/$(database)/documents/familyInvites/$(request.resource.data.joined_via_invite))
          && get(/databases/$(database)/documents/familyInvites/$(request.resource.data.joined_via_invite)).data.family_id
            == request.resource.data.family_id
          && get(/databases/$(database)/documents/familyInvites/$(request.resource.data.joined_via_invite)).data.status == 'ACTIVE'
        );
    }

    function canMintInvite(familyId) {
      return familyAdminOrOwner(familyId)
        || (
          familyMemberLoose(familyId)
          && (
            familyHasNoOwner(familyId)
            || familyOwnerUid(familyId) == request.auth.uid
            // Linked account for this family may mint even if member role is still MEMBER
            || profileLinkedToFamily(familyId)
          )
        )
        || (
          profileLinkedToFamily(familyId)
          && (
            familyHasNoOwner(familyId)
            || !exists(/databases/$(database)/documents/families/$(familyId))
          )
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && userFamilyIdCreateOk();
      allow update: if isOwner(userId) && userFamilyIdWriteOk();
      allow delete: if isOwner(userId);

      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      match /cloudSnapshots/{snapshotId} {
        allow read, write: if isOwner(userId);

        match /parts/{partId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    match /families/{familyId} {
      allow get: if familyMemberLoose(familyId)
        || (
          signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.family_id == familyId
        );
      allow list: if false;
      allow create: if signedIn();

      allow update: if familyOwner(familyId)
        || (familyAdminOrOwner(familyId) && familySettingsKeysOnly())
        || familyMetaBootstrapOwner(familyId)
        || familyMetaOwnerHeal(familyId);

      match /members/{memberId} {
        allow read: if familyMemberLoose(familyId)
          || (signedIn() && request.auth.uid == memberId)
          || (signedIn() && resource.data.uid == request.auth.uid);

        allow create: if selfCreateFirstOwner(familyId)
          || selfCreateViaInvite(familyId)
          || selfCreateLinkedMember(familyId);

        allow update: if familyOwner(familyId)
          || (familyAdminOrOwner(familyId)
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
          || (signedIn()
              && request.auth.uid == memberId
              && memberSelfSafeKeysOnly())
          || (signedIn()
              && request.auth.uid == memberId
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['fcm_token_latest', 'fcm_updated_at', 'updated_at']))
          || selfClaimOwnerRole(familyId);

        allow delete: if familyOwner(familyId)
          || (signedIn() && request.auth.uid == memberId);
      }

      match /fcmTokens/{tokenId} {
        allow read: if familyMemberLoose(familyId)
          || (signedIn() && resource.data.uid == request.auth.uid);
        allow create, update: if familyMemberLoose(familyId)
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn()
          && resource.data.uid == request.auth.uid;
      }

      // Members OR profile-linked accounts may sync shared finance snapshots.
      match /cloudSnapshots/{snapshotId} {
        allow read, write: if familyMemberLoose(familyId) || profileLinkedToFamily(familyId);

        match /parts/{partId} {
          allow read, write: if familyMemberLoose(familyId) || profileLinkedToFamily(familyId);
        }
      }
    }

    match /familyInvites/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.keys().hasAll(['code', 'family_id', 'owner_uid', 'status'])
        && canMintInvite(request.resource.data.family_id);

      allow update: if signedIn() && (
        resource.data.owner_uid == request.auth.uid
        || (
          inviteConsumeKeysOnly()
          && request.resource.data.last_joined_uid == request.auth.uid
          && request.resource.data.uses == resource.data.uses + 1
          && resource.data.status == 'ACTIVE'
          && resource.data.family_id is string
        )
      );

      allow delete: if signedIn()
        && resource.data.owner_uid == request.auth.uid;
    }
  }
}
