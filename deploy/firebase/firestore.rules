rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function emailOk() {
      return request.auth.token.email_verified == true;
    }

    // Membership without requiring email verify — used for finance snapshot sync
    function familyMemberLoose(familyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function familyMember(familyId) {
      return familyMemberLoose(familyId) && emailOk();
    }

    function familyOwner(familyId) {
      return familyMember(familyId)
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'OWNER';
    }

    function familyAdminOrOwner(familyId) {
      return familyMember(familyId)
        && get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role in ['OWNER', 'ADMIN'];
    }

    function memberRole(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role;
    }

    // Keys allowed when Owner/Admin updates currency / timezone (settings.manage)
    function familySettingsKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['currency', 'default_currency', 'timezone', 'updated_at', 'name']);
    }

    // First owner may set owner_uid when family meta has no owner yet
    function familyMetaBootstrapOwner(familyId) {
      return familyMemberLoose(familyId)
        && memberRole(familyId) == 'OWNER'
        && (
          !('owner_uid' in resource.data)
          || resource.data.owner_uid == null
          || resource.data.owner_uid == ''
        )
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['owner_uid', 'name', 'id', 'created_at', 'updated_at', 'currency', 'default_currency', 'timezone']);
    }

    function familyHasNoOwner(familyId) {
      return !exists(/databases/$(database)/documents/families/$(familyId))
        || !('owner_uid' in get(/databases/$(database)/documents/families/$(familyId)).data)
        || get(/databases/$(database)/documents/families/$(familyId)).data.owner_uid == null
        || get(/databases/$(database)/documents/families/$(familyId)).data.owner_uid == '';
    }

    function familyOwnerUid(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data.owner_uid;
    }

    // Self-create as first OWNER when family has no owner yet
    function selfCreateFirstOwner(familyId) {
      return signedIn()
        && emailOk()
        && request.auth.uid == memberId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'OWNER'
        && (
          familyHasNoOwner(familyId)
          || familyOwnerUid(familyId) == request.auth.uid
        );
    }

    function inviteDoc(code) {
      return get(/databases/$(database)/documents/familyInvites/$(code));
    }

    function inviteValidForJoin(familyId, code) {
      return code is string
        && code.size() >= 4
        && exists(/databases/$(database)/documents/familyInvites/$(code))
        && inviteDoc(code).data.status == 'ACTIVE'
        && inviteDoc(code).data.family_id == familyId
        && inviteDoc(code).data.uses < inviteDoc(code).data.max_uses;
    }

    // Join via invite — non-privileged role only
    function selfCreateViaInvite(familyId) {
      return signedIn()
        && emailOk()
        && request.auth.uid == memberId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['MEMBER', 'VIEWER', 'CHILD']
        && request.resource.data.keys().hasAll(['invite_code'])
        && inviteValidForJoin(familyId, request.resource.data.invite_code);
    }

    function memberSelfSafeKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'email',
          'display_name',
          'fcm_token_latest',
          'fcm_updated_at',
          'updated_at',
          'status',
          'photo_url',
          'avatar_url',
          'invite_code'
        ]);
    }

    function inviteConsumeKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['uses', 'status', 'updated_at', 'last_joined_uid']);
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      // Finance backup/sync — owner only; email verify NOT required (multi-device sync)
      match /cloudSnapshots/{snapshotId} {
        allow read, write: if isOwner(userId);

        match /parts/{partId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // Shared family shell + snapshot (multi-account truth)
    match /families/{familyId} {
      allow read: if familyMemberLoose(familyId);
      allow create: if signedIn() && emailOk();

      // Owner: full meta updates
      // Admin: currency + timezone (+ name) only
      // Bootstrap: first OWNER may set owner_uid when empty
      allow update: if familyOwner(familyId)
        || (familyAdminOrOwner(familyId) && familySettingsKeysOnly())
        || familyMetaBootstrapOwner(familyId);

      match /members/{memberId} {
        allow read: if familyMemberLoose(familyId)
          || (signedIn() && request.auth.uid == memberId);

        // Create self only: first OWNER, or MEMBER/VIEWER/CHILD with valid invite_code
        allow create: if selfCreateFirstOwner(familyId)
          || selfCreateViaInvite(familyId);

        // Owner: full member updates. Admin: anything except role. Self: safe profile/FCM keys only.
        allow update: if familyOwner(familyId)
          || (familyAdminOrOwner(familyId)
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
          || (signedIn()
              && request.auth.uid == memberId
              && memberSelfSafeKeysOnly())
          || (signedIn()
              && request.auth.uid == memberId
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['fcm_token_latest', 'fcm_updated_at', 'updated_at']));

        allow delete: if familyOwner(familyId)
          || (signedIn() && emailOk() && request.auth.uid == memberId);
      }

      match /fcmTokens/{tokenId} {
        allow read: if familyMemberLoose(familyId)
          || (signedIn() && resource.data.uid == request.auth.uid);
        allow create, update: if familyMemberLoose(familyId)
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn()
          && resource.data.uid == request.auth.uid;
      }

      // Shared finance snapshot — members can sync without email verify (product choice)
      match /cloudSnapshots/{snapshotId} {
        allow read, write: if familyMemberLoose(familyId);

        match /parts/{partId} {
          allow read, write: if familyMemberLoose(familyId);
        }
      }
    }

    // Global invite codes — get by known code OK; no collection listing
    match /familyInvites/{code} {
      allow get: if signedIn() && emailOk();
      allow list: if false;

      allow create: if signedIn()
        && emailOk()
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.keys().hasAll(['code', 'family_id', 'owner_uid', 'status'])
        && familyAdminOrOwner(request.resource.data.family_id);

      // Owner revoke/edit, or joiner consume (uses/status only)
      allow update: if signedIn() && emailOk() && (
        resource.data.owner_uid == request.auth.uid
        || (
          inviteConsumeKeysOnly()
          && request.resource.data.last_joined_uid == request.auth.uid
          && request.resource.data.uses == resource.data.uses + 1
          && resource.data.status == 'ACTIVE'
          && resource.data.family_id is string
        )
      );

      allow delete: if signedIn() && emailOk()
        && resource.data.owner_uid == request.auth.uid;
    }
  }
}
