rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function emailOk() {
      return request.auth.token.email_verified == true;
    }

    // Align with Firestore familyMemberLoose — membership doc is enough for file I/O
    function familyMemberLoose(familyId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function familyMember(familyId) {
      return familyMemberLoose(familyId) && emailOk();
    }

    // Profile avatars: users/{uid}/profile/avatar.* — owner only (no email gate)
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/jpg|image/png|image/webp');
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Family documents + attachments
    match /families/{familyId}/{allPaths=**} {
      allow read: if familyMemberLoose(familyId);

      allow create, update: if familyMemberLoose(familyId)
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/.*|application/pdf|application/octet-stream|text/.*|application/msword|application/vnd\\..*|application/zip|application/x-zip-compressed'
        );

      // Deletes have no request.resource — must not reuse create/update checks
      allow delete: if familyMemberLoose(familyId);
    }
  }
}
