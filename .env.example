# S4 Family Finance — Development .env (WSL / Docker Compose)
# Copy:  cp .env.example .env
# Then:  docker compose up --build

# --- Core (architecture) ---
POSTGRES_DB=s4family
POSTGRES_USER=s4user
POSTGRES_PASSWORD=s4pass_dev
REDIS_PASSWORD=s4redis_dev
SECRET_KEY=dev-secret-change-me
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE=15
REFRESH_TOKEN_EXPIRE=30
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=development
DEBUG=true

# --- Database / Redis (compose network hostnames) ---
DATABASE_URL=postgresql+psycopg://s4user:s4pass_dev@postgres:5432/s4family
REDIS_URL=redis://:s4redis_dev@redis:6379/0
CELERY_ENABLED=true
AUTO_CREATE_TABLES=true

# --- Object storage (MinIO = local S3) ---
# Architecture aliases AWS_* map to S3_* used by the app
AWS_ACCESS_KEY=s4minio
AWS_SECRET_KEY=s4minio_dev
S3_ACCESS_KEY=s4minio
S3_SECRET_KEY=s4minio_dev
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=s4family-dev
DOCUMENT_VAULT_BACKEND=s3
MINIO_ROOT_USER=s4minio
MINIO_ROOT_PASSWORD=s4minio_dev

# --- Optional live integrations (leave empty until real keys exist) ---
# Architecture name GOOGLE_VISION_KEY → use credentials file path for Vision SDK
GOOGLE_VISION_KEY=
GOOGLE_VISION_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=

# Architecture name FCM_SERVER_KEY → app uses Firebase service-account JSON
FCM_SERVER_KEY=
NOTIFICATION_FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

NOTIFICATION_EMAIL_ENABLED=false
AUTH_EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=

CORS_ORIGINS=["http://localhost","http://127.0.0.1","http://localhost:5173","http://127.0.0.1:5173","http://localhost:80"]
APP_PUBLIC_URL=http://localhost

# --- Monitoring (Grafana + Prometheus overlay) ---
# docker compose -f docker-compose.yml -f deploy/monitoring/docker-compose.monitoring.yml up -d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=s4grafana_dev
GRAFANA_ROOT_URL=http://localhost:3000
POSTGRES_EXPORTER_DSN=postgresql://s4user:s4pass_dev@postgres:5432/s4family?sslmode=disable
REDIS_EXPORTER_ADDR=redis://:s4redis_dev@redis:6379

# Alert webhooks (optional — leave empty until Slack/PagerDuty/Email bridge ready)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# PAGERDUTY_WEBHOOK_URL=https://events.pagerduty.com/...
# EMAIL_WEBHOOK_URL=https://your-email-bridge/...

# Sentry (optional)
# SENTRY_DSN=
# VITE_SENTRY_DSN=
