# Copy this file to .env.local for local development or configure these values
# as deployment secrets/environment variables in production.
# Never commit real .env.local values.

# Browser-facing FastAPI base URL.
NEXT_PUBLIC_API_BASE=http://localhost:8001/api

# Server-side admin proxy base URL. In production this can be an internal URL.
BACKEND_API_BASE=http://localhost:8001/api

# Must match backend ADMIN_API_KEY. Generate a long random value.
ADMIN_API_KEY=change-me-to-the-same-long-random-backend-admin-api-key

# Admin dashboard session secret. Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-auth-secret

# Admin dashboard credentials. Generate/update hash with:
# npm run set-admin-password "your-password" "admin"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:replace-with-generated-salt:replace-with-generated-hash

# Public legal/business information shown on legal pages.
NEXT_PUBLIC_LEGAL_BUSINESS_NAME=S4BUSINESSTHINKING
NEXT_PUBLIC_LEGAL_REGISTERED_ADDRESS=Bangladesh
NEXT_PUBLIC_LEGAL_JURISDICTION=Bangladesh
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=2026-07-18
