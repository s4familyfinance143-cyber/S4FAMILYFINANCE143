# S4 Family Finance — mobile env



# Firebase-first (default true) — same cloud mode as web Hosting build

EXPO_PUBLIC_FIREBASE_FIRST=true

EXPO_PUBLIC_REQUIRE_EMAIL_VERIFICATION=true



# Google Sign-In (Firebase Console → Authentication → Google → Web client ID)

# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=



# Optional overrides (defaults match web s4-family-finance project)

# EXPO_PUBLIC_FIREBASE_API_KEY=

# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=

# EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# EXPO_PUBLIC_FIREBASE_APP_ID=



# Backend JWT mode only (when EXPO_PUBLIC_FIREBASE_FIRST=false)

# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000



# EXPO_PUBLIC_SENTRY_DSN=


