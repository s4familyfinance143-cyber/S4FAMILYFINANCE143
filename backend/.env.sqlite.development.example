# S4 FAMILY FINANCE 143 — SQLite Development Environment

APP_NAME="S4 FAMILY FINANCE"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"

DATABASE_URL="sqlite:///./s4_family_finance_dev.db"

JWT_SECRET_KEY="CHANGE_THIS_SECRET_KEY_BEFORE_PRODUCTION"
JWT_ALGORITHM="RS256"
BCRYPT_ROUNDS=12

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

AUTO_CREATE_TABLES=true
ENABLE_RECURRING_WORKER=true
ENABLE_AUTO_BACKUP_WORKER=true

NOTIFICATION_IN_APP_ENABLED=true
NOTIFICATION_FCM_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false
FCM_PROJECT_ID=""
FCM_CREDENTIALS_PATH=""

DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
