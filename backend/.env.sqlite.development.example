# S4 FAMILY FINANCE 143 — SQLite Development Environment

APP_NAME="S4 FAMILY FINANCE"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"

DATABASE_URL="sqlite:///./s4_family_finance_dev.db"

JWT_SECRET_KEY="CHANGE_THIS_SECRET_KEY_BEFORE_PRODUCTION"
JWT_ALGORITHM="RS256"
BCRYPT_ROUNDS=12

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

AUTO_CREATE_TABLES=true
ENABLE_RECURRING_WORKER=true
ENABLE_AUTO_BACKUP_WORKER=true

NOTIFICATION_IN_APP_ENABLED=true
NOTIFICATION_FCM_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false
FCM_PROJECT_ID=""
FCM_CREDENTIALS_PATH=""

DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# Optional: Redis + Celery (run deploy/scripts/start_local_redis_mailpit.ps1)
# REDIS_URL=redis://:s4redis_dev@127.0.0.1:6380/0
# CELERY_ENABLED=true

# Optional: Mailpit local email (UI http://127.0.0.1:8025)
# AUTH_EMAIL_ENABLED=true
# NOTIFICATION_EMAIL_ENABLED=true
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_FROM_EMAIL=noreply@s4family.local
# SMTP_FROM_NAME=S4 Family Finance
# SMTP_USE_TLS=false
# APP_PUBLIC_URL=http://127.0.0.1:5173

# Optional: FCM push — see deploy/EMAIL_FCM_SETUP.md
# NOTIFICATION_FCM_ENABLED=true
# FCM_PROJECT_ID=
# FCM_CREDENTIALS_PATH=./secrets/firebase-service-account.json
