# S4 FAMILY FINANCE 143 — Backend Environment Example

# For local development:
# Copy .env.sqlite.development.example to .env
#
# For PostgreSQL production:
# Copy .env.postgresql.production.example to .env
#
# Never commit real production .env secrets to GitHub.

APP_NAME="S4 FAMILY FINANCE"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"

DATABASE_URL="sqlite:///./s4_family_finance_dev.db"

JWT_SECRET_KEY="CHANGE_THIS_SECRET_KEY_BEFORE_PRODUCTION"
JWT_ALGORITHM="RS256"
BCRYPT_ROUNDS=12

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

AUTO_CREATE_TABLES=true
ENABLE_RECURRING_WORKER=true
ENABLE_AUTO_BACKUP_WORKER=true

DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:8081","http://127.0.0.1:8081","http://localhost:19006","http://127.0.0.1:19006"]

# Real SMTP (no fake send). Leave empty until you have a real mailbox.
# AUTH_EMAIL_ENABLED=true
# NOTIFICATION_EMAIL_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_FROM_NAME=S4 Family Finance
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# APP_PUBLIC_URL=http://127.0.0.1:5173

# FCM push (set real Firebase service-account JSON path)
# NOTIFICATION_FCM_ENABLED=true
# FCM_PROJECT_ID=your-firebase-project
# FCM_CREDENTIALS_PATH=./secrets/firebase-service-account.json

# Google Vision OCR (optional — text paste + Tesseract also work)
# GOOGLE_VISION_ENABLED=true
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-vision.json

# Document vault S3/MinIO (optional — AES local vault is architecture-complete)
# DOCUMENT_VAULT_BACKEND=auto
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_BUCKET=s4-documents
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# DOCUMENT_VAULT_KEY=
