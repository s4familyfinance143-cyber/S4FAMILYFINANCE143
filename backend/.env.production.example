# S4 FAMILY FINANCE 143 - PRODUCTION ENV EXAMPLE
# Copy this file to backend\.env.production and edit values before running production.

ENVIRONMENT=production
AUTO_CREATE_TABLES=false

# PostgreSQL production database
POSTGRES_DB=s4_family_finance_production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/s4_family_finance_production

# Must be 64+ random characters. Do not use this placeholder in production.
JWT_SECRET_KEY=CHANGE_ME_RANDOM_64_PLUS_CHAR_SECRET
JWT_SECRET=CHANGE_ME_RANDOM_64_PLUS_CHAR_SECRET
SECRET_KEY=CHANGE_ME_RANDOM_64_PLUS_CHAR_SECRET
APP_SECRET_KEY=CHANGE_ME_RANDOM_64_PLUS_CHAR_SECRET
S4_JWT_SECRET_KEY=CHANGE_ME_RANDOM_64_PLUS_CHAR_SECRET
S4_SECRET_KEY=CHANGE_ME_RANDOM_64_PLUS_CHAR_SECRET
# HS256 uses JWT_SECRET_KEY only. For RS256 set JWT_PRIVATE_KEY + JWT_PUBLIC_KEY (or mount PEMs).
JWT_ALGORITHM=HS256

ENABLE_RECURRING_WORKER=false
ENABLE_AUTO_BACKUP_WORKER=false

# Redis/Celery readiness. Redis is included in production compose; Celery worker code is future/optional.
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0

# MinIO/S3 readiness for future document storage integrations.
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_ROOT_PASSWORD
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=s4-family-finance
S3_ACCESS_KEY=CHANGE_ME_MINIO_ROOT_USER
S3_SECRET_KEY=CHANGE_ME_STRONG_MINIO_ROOT_PASSWORD

# Push/email delivery remain deploy-time integrations. Keep disabled until real provider secrets are configured.
NOTIFICATION_FCM_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# Frontend/API deployment
VITE_API_BASE=/api/v1
CORS_ORIGINS=["https://your-domain.example"]

# Real SMTP (no fake send). Fill before enabling NOTIFICATION_EMAIL_ENABLED / auth mail delivery.
# AUTH_EMAIL_ENABLED=true
# NOTIFICATION_EMAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@your-domain.com
# SMTP_FROM_NAME=S4 Family Finance
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# APP_PUBLIC_URL=https://your-domain.example
