# S4 FAMILY FINANCE 143 — PostgreSQL Production Environment

APP_NAME="S4 FAMILY FINANCE"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="production"

# IMPORTANT:
# - Use PostgreSQL in production.
# - URL-encode special characters in password.
# - Example: @ becomes %40
DATABASE_URL="postgresql+psycopg://s4_user:CHANGE_PASSWORD@127.0.0.1:5432/s4_family_finance"

# IMPORTANT:
# Replace this with a strong random production secret.
JWT_SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_PRODUCTION_SECRET"
JWT_ALGORITHM="RS256"
BCRYPT_ROUNDS=12

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Production must use Alembic migrations, not Base.metadata.create_all.
AUTO_CREATE_TABLES=false

ENABLE_RECURRING_WORKER=true
ENABLE_AUTO_BACKUP_WORKER=true

DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
