        SELECT COUNT(*)
        FROM audit_logs
        WHERE family_id IS NULL OR family_id = ''
    """)).scalar()

    empty_family_sync_outbox = conn.execute(text("""
        SELECT COUNT(*)
        FROM sync_outbox
        WHERE family_id IS NULL OR family_id = ''
    """)).scalar()

    empty_family_sync_conflicts = conn.execute(text("""
        SELECT COUNT(*)
        FROM sync_conflicts
        WHERE family_id IS NULL OR family_id = ''
    """)).scalar()

