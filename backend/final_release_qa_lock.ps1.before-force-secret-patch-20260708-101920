    ("hardcoded_password_plain", re.compile(r'password\s*=\s*["\'][^"\']+["\']', re.I)),
    ("hardcoded_secret_plain", re.compile(r'(secret|token|jwt_secret)\s*=\s*["\'][^"\']{10,}["\']', re.I)),
]

